-		scene_root->set_default_canvas_item_texture_repeat(tr);
+
+	// =====
+	// Debug
+	// =====
+	// Shapes
+	// ------
+	if (ProjectSettings::get_singleton()->check_changed_settings_in_group("debug/shapes")) {
