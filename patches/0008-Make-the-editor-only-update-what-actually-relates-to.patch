+			tree->set_debug_collision_contact_color(
+					Color(GLOBAL_GET("debug/shapes/collision/contact_color")));
+
+			tree->set_debug_collisions_color(
+					Color(GLOBAL_GET("debug/shapes/collision/shape_color")));
+		}
+
+#ifdef DEBUG_ENABLED
